# --- Sarvam Voice Agents (Samvaad) ---
# Create a Voice Agents key at https://indus.sarvam.ai/samvaad/settings/api-key
# (this is NOT the same as a Sarvam TTS/STT API key)
SARVAM_API_KEY=
SARVAM_ORG_ID=01a19665-d999-7047-9b3f-3adb3911dfff
SARVAM_WORKSPACE_ID=01a19665-d9a1-752e-834b-91ec0262df74

# From your agent's "Deploy with Code" page: https://indus.sarvam.ai/samvaad/deploy/with-code
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
# Telephony connection (Exotel / rented Sarvam number) from Deploy -> Telephony
SARVAM_CONNECTION_ID=
# E.164, e.g. +918041234567
SARVAM_AGENT_PHONE_NUMBER=

# --- Webhook ---
# Public HTTPS base URL of this backend (ngrok / cloudflared), no trailing slash
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# Random secret appended as ?token= to the webhook URL we register with Sarvam
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql+psycopg://advisor:advisor@localhost:5432/advisor

# --- CORS (comma-separated origins allowed to call /leads) ---
CORS_ORIGINS=http://localhost:3000
